      {
        "clip_id": "G00015_19_20_037",
        "audio_path": "Audio/wav/G00015/G00015_19/G00015_19_20/G00015_19_20_037.wav",
        "speaker_id": "20",
        "text": "孩子爸爸，爸爸在国外，他不知道这些情况。",
        "emotion": "fearful",
        "start_s": 86.3633689986847,
        "end_s": 89.78424295564567
      },
      {
        "clip_id": "G00015_19_21_038",
        "audio_path": "Audio/wav/G00015/G00015_19/G00015_19_21/G00015_19_21_038.wav",
        "speaker_id": "21",
        "text": "孩子爸爸在国外不知道这些情况。[over/]你[/over]，你最近啊问一个问[over/]题[/over]，但是你不要敏感啊。",
        "emotion": "neutral",
        "start_s": 90.148563728742,
        "end_s": 94.65979556288336
      },
      {
        "clip_id": "G00015_19_21_040",
        "audio_path": "Audio/wav/G00015/G00015_19/G00015_19_21/G00015_19_21_040.wav",
        "speaker_id": "21",
        "text": "你们家最近和别人家有没有产生矛盾之类的事情？",
        "emotion": "neutral",
        "start_s": 95.0666696446712,
        "end_s": 98.34807651914238
      }
    ],
    "note": "Labels included for audit only; never supply history gold labels or target captions to the model. This example does not prove that context improves classification."
  },
