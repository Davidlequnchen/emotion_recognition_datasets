      "audio_path": "Audio/wav/G00015/G00015_24/G00015_24_20/G00015_24_20_018.wav",
      "speaker_id": "20",
      "text": "哎，对。",
      "emotion": "neutral",
      "start_s": 36.19916941011578,
      "end_s": 36.89363346433828,
      "duration_s": 0.6944671201814059
    },
    "past": [
